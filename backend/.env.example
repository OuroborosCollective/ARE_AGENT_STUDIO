API_BACKEND_HOST=127.0.0.1
API_BACKEND_PORT=8080
API_PAYLOAD_MAX_SIZE=25mb
DATASET_DIR=./data
DATASET_WRITE_ENABLED=true
DATASET_EXPORT_ENABLED=false
OPERATION_CORRECTION_DIR=./data
OPERATION_CORRECTION_WRITE_ENABLED=false
VERIFIED_IMITATION_DIR=./data
VERIFIED_IMITATION_WRITE_ENABLED=false
# Public links contain no credentials. Leave unpublished links blank rather than inventing a target.
PUBLIC_SOURCE_REPOSITORY_URL=https://github.com/OuroborosCollective/ARE_AGENT_STUDIO
PUBLIC_HUGGING_FACE_PROJECT_URL=
PUBLIC_APK_CLIENT_REPOSITORY_URL=https://github.com/OuroborosCollective/ARE_AGENT_STUDIO
PUBLIC_APK_RELEASE_URL=
# A payment redirect is opt-in. This daemon never stores PayPal or crypto secrets.
PUBLIC_PAYMENT_PROVIDER=none
PUBLIC_CHECKOUT_URL=
STATIC_DIR=
DATASET_AUTH_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ADVISORY_API_URL=
ADVISORY_API_TOKEN=
ADVISORY_MODEL=
# Human-readable non-secret label exposed by /api/v1/health when advisory is configured.
# Use a fixed approved OpenAI-compatible route (for example OpenRouter or a compatible OmniRoute deployment).
ADVISORY_PROVIDER_LABEL=
ENABLE_ADB_BRIDGE=false
ADB_ALLOWED_SERIALS=
